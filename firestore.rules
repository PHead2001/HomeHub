rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identity
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    // User profile documents are keyed by the Firebase Auth email.
    function isProfileOwner(userEmail) {
      return signedIn() && request.auth.token.email == userEmail;
    }

    // ---------------------------------------------------------------------
    // Device principals: registered wall tablets (docs/modules/devices/README.md).
    // A device token has no email, so signedIn() and every member helper stay
    // false for it. Device access is added only as separate `||` clauses on
    // reads; no write rule has a device clause (device changes go through server
    // actions). Every helper takes the household from the PATH and requires the
    // token to name that household; the device record read is the one under that
    // path's household.
    // ---------------------------------------------------------------------

    function isDevicePrincipal() {
      return request.auth != null &&
        request.auth.token.get('hh_kind', '') == 'device' &&
        request.auth.token.firebase.get('sign_in_provider', '') == 'custom' &&
        !('email' in request.auth.token) &&
        request.auth.token.get('hh_device', '') is string &&
        request.auth.uid == 'device_' + request.auth.token.get('hh_device', '') &&
        request.auth.token.get('hh_gen', null) is number;
    }

    function deviceDocPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/devices/$(request.auth.token.hh_device);
    }

    function householdDocPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    // The token names this household (no document read).
    function isDevice(householdId) {
      return isDevicePrincipal() && request.auth.token.get('hh_household', '') == householdId;
    }

    // Registered, active, current credential generation, household not being deleted.
    // isDevice() first, so a personal request short-circuits before any get().
    function deviceActive(householdId) {
      return isDevice(householdId) &&
        get(deviceDocPath(householdId)).data.get('status', '') == 'active' &&
        get(deviceDocPath(householdId)).data.get('generation', null) == request.auth.token.hh_gen &&
        !('deletingAt' in get(householdDocPath(householdId)).data);
    }

    // Chores, shopping, pets, calendar, maintenance: the device record's switch.
    function sectionEnabled(householdId, section) {
      return deviceActive(householdId) &&
        get(deviceDocPath(householdId)).data.get('sections', {}).get(section, false) == true;
    }

    // Household-wide ('*') notices of a source the tablet shows. Only the exact
    // per-category queries the tablet runs can be proven (one category each).
    function deviceNotificationReadable(householdId) {
      return deviceActive(householdId) &&
        resource.data.audience.hasAny(['*']) &&
        (resource.data.category == 'system' ||
          resource.data.category == 'general' ||
          (resource.data.category == 'chores' && sectionEnabled(householdId, 'chores')) ||
          (resource.data.category == 'pets' && sectionEnabled(householdId, 'pets')) ||
          (resource.data.category == 'shopping' && sectionEnabled(householdId, 'shopping')) ||
          (resource.data.category == 'maintenance' && sectionEnabled(householdId, 'maintenance')));
    }

    // ---------------------------------------------------------------------
    // Household membership
    //
    // households/{householdId}/members/{uid} is the only authority for access.
    // Legacy fields (households.memberEmails, households.ownerEmail and
    // users/{email}.householdId/role) are display/compatibility data and never
    // grant access on their own.
    // ---------------------------------------------------------------------

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function hasMemberDoc(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function myMember(householdId) {
      return get(memberPath(householdId, request.auth.uid)).data;
    }

    function isApprovedMemberData(member) {
      return member.role in ['owner', 'admin', 'member', 'child', 'guest'] &&
        member.get('status', 'active') == 'active';
    }

    function isApprovedMember(householdId) {
      return hasMemberDoc(householdId) && isApprovedMemberData(myMember(householdId));
    }

    // During a household deletion every membership is set to status `deleting`. A
    // member who was approved (any role but a pending `newuser`) may still read the
    // household document then, so a failed deletion can be seen and the owner can
    // finish it (the server action checks owner and deleting state itself). Nothing
    // else in the household is readable to them.
    function isDeletingMember(householdId) {
      return hasMemberDoc(householdId) &&
        myMember(householdId).get('status', '') == 'deleting' &&
        myMember(householdId).role in ['owner', 'admin', 'member', 'child', 'guest'];
    }

    function isOwnerRole(householdId) {
      return isApprovedMember(householdId) && myMember(householdId).role == 'owner';
    }

    function isAdminRole(householdId) {
      return isApprovedMember(householdId) && myMember(householdId).role == 'admin';
    }

    function isOwnerOrAdmin(householdId) {
      return isOwnerRole(householdId) || isAdminRole(householdId);
    }

    function roleHasPermission(role, permission) {
      return role == 'owner' ||
        (role == 'admin' && !(permission in ['household.delete', 'household.transferOwnership'])) ||
        (role == 'member' && permission in [
          'household.view',
          'chores.view', 'chores.complete', 'chores.create', 'chores.edit', 'chores.assign',
          'shopping.view', 'shopping.edit',
          'pets.view', 'pets.addLogs',
          'maintenance.view', 'maintenance.createLogs', 'maintenance.edit',
          'automation.view',
          'notifications.view', 'notifications.dismiss'
        ]) ||
        (role == 'child' && permission in [
          'household.view', 'chores.view', 'chores.complete', 'pets.view', 'pets.addLogs',
          'notifications.view', 'notifications.dismiss'
        ]) ||
        (role == 'guest' && permission in [
          'household.view', 'chores.view', 'shopping.view', 'pets.view',
          'maintenance.view', 'notifications.view'
        ]);
    }

    // Owners always hold every permission. Overrides apply to every other role.
    function memberHasPermission(member, permission) {
      let overrides = member.get('permissions', {});
      return isApprovedMemberData(member) &&
        (member.role == 'owner' ||
          (permission in overrides
            ? overrides[permission] == true
            : roleHasPermission(member.role, permission)));
    }

    function hasHouseholdPermission(householdId, permission) {
      return hasMemberDoc(householdId) && memberHasPermission(myMember(householdId), permission);
    }

    // Reads that exist only for the Household Manager (invite codes, the activity
    // log, other members' contact documents) also need household.view, so a member
    // with View household unticked reads none of them, whatever else they hold.
    // Owners always hold it; for everyone else the role default or override decides.
    function hasHouseholdManagerPermission(householdId, permission) {
      return hasHouseholdPermission(householdId, 'household.view') &&
        hasHouseholdPermission(householdId, permission);
    }

    // ---------------------------------------------------------------------
    // Household document invariants
    // ---------------------------------------------------------------------

    // The only client write to a household document: owners and admins may set
    // the household time zone. Name, owner and member fields are server-written.
    function validHouseholdTimeZone() {
      return request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 64;
    }

    // ---------------------------------------------------------------------
    // Profiles
    // ---------------------------------------------------------------------

    function updatesOwnProfileOnly(userEmail) {
      return isProfileOwner(userEmail) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'displayName',
          'firstName',
          'lastName',
          'avatarUrl',
          'theme',
          'choreSettings',
          'fcmTokens',
          'birthday',
          'gender',
          'preferences',
          'timeZone',
          'forcePasswordChange'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
        noNewDemographics() &&
        legacyPushTokensOnlyShrink();
    }

    // Google birthday and gender are no longer collected. Profiles that still
    // hold them stay readable and updatable (and may drop them), but no write
    // may add or change either field.
    function noNewDemographics() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['birthday']) || !('birthday' in request.resource.data)) &&
        (!changed.hasAny(['gender']) || !('gender' in request.resource.data));
    }

    // Push tokens now live in users/{email}/private/push, which only the owner
    // can read. The legacy profile field may only shrink or be removed until the
    // migration (scripts/ops/migrate-push-tokens.mjs) empties it.
    function legacyPushTokensOnlyShrink() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fcmTokens']) ||
        !('fcmTokens' in request.resource.data) ||
        (
          request.resource.data.fcmTokens is list &&
          resource.data.get('fcmTokens', []) is list &&
          resource.data.get('fcmTokens', []).hasAll(request.resource.data.fcmTokens)
        );
    }

    // updatedAt, when written, is the server time; an update may leave it as is.
    function validPushTokenDoc(data, previous) {
      return data.keys().hasOnly(['fcmTokens', 'updatedAt']) &&
        data.fcmTokens is list &&
        data.fcmTokens.size() <= 20 &&
        (
          !('updatedAt' in data) ||
          data.updatedAt == request.time ||
          (previous != null && data.updatedAt == previous.get('updatedAt', null))
        );
    }

    // The server (Admin SDK) writes the household fields of every profile. The only
    // client write to them is a person clearing their own stale household pointer.
    function clearsOwnMembershipCache(userEmail) {
      return isProfileOwner(userEmail) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['householdId', 'role', 'permissions']) &&
        request.resource.data.householdId == null &&
        request.resource.data.role == 'member' &&
        request.resource.data.get('permissions', {}) == {};
    }

    function canReadProfile(userEmail) {
      // The person only. Housemates see each other through the membership
      // records (public member data); the server reads profiles with the Admin SDK.
      return isProfileOwner(userEmail);
    }

    // ---------------------------------------------------------------------
    // Notifications
    // ---------------------------------------------------------------------

    // An in-app path: one leading slash not followed by a slash or backslash,
    // and no control characters anywhere (URL parsing drops tabs and newlines,
    // so "/<tab>/evil" would otherwise open as "//evil").
    function validDeepLink(data) {
      return !('deepLink' in data) ||
        (data.deepLink is string && data.deepLink.matches('^/([^/\\\\\\x00-\\x1f\\x7f][^\\x00-\\x1f\\x7f]*)?$') && data.deepLink.size() <= 300);
    }

    // A notification names its target by account ID only (`targetUserUid`, a
    // member of this household); `targetUserEmail` is not accepted.
    function validNotificationTarget(householdId, data) {
      return !('targetUserUid' in data) ||
        (data.targetUserUid is string && exists(memberPath(householdId, data.targetUserUid)));
    }

    // `audience` names who the notification is for: [targetUserUid] for one
    // member, ['*'] for the household (the derivation of notificationAudience).
    // Required on every client create, because reads return only documents
    // whose audience names the reader or everyone. A client may not write an
    // email-only target: without a uid it could not name anyone.
    function validNotificationAudience(data) {
      return data.audience is list &&
        data.audience.size() == 1 &&
        data.audience[0] is string &&
        ('targetUserUid' in data
          ? data.audience[0] == data.targetUserUid
          : (!('targetUserEmail' in data) && data.audience[0] == '*'));
    }

    // The reader is in the notification's audience. Used by the update rule;
    // the read rule spells the same check out so list queries are proven
    // against `audience` array-contains-any [uid, '*'].
    function notificationAddressedToCaller() {
      return resource.data.audience is list &&
        resource.data.audience.hasAny([request.auth.uid, '*']);
    }

    function canSendCategory(householdId, category) {
      return (category == 'chores' && (hasHouseholdPermission(householdId, 'chores.assign') ||
          hasHouseholdPermission(householdId, 'chores.create') || hasHouseholdPermission(householdId, 'chores.edit'))) ||
        // Anyone who can see chores may remind themselves (daily/overdue reminders).
        (category == 'chores' && hasHouseholdPermission(householdId, 'chores.view') &&
          request.resource.data.get('sourceType', '') == 'chore-reminder' &&
          request.resource.data.get('targetUserUid', '') == request.auth.uid) ||
        (category == 'maintenance' && (hasHouseholdPermission(householdId, 'maintenance.createLogs') ||
          hasHouseholdPermission(householdId, 'maintenance.edit'))) ||
        (category == 'shopping' && hasHouseholdPermission(householdId, 'shopping.edit')) ||
        (category == 'pets' && hasHouseholdPermission(householdId, 'pets.addLogs')) ||
        (category == 'automation' && hasHouseholdPermission(householdId, 'automation.manage')) ||
        (category in ['system', 'general'] && isOwnerOrAdmin(householdId));
    }

    function validNewNotification(householdId) {
      let data = request.resource.data;
      return isApprovedMember(householdId) &&
        canSendCategory(householdId, data.category) &&
        // No future-dated notifications (they would win de-duplication). Past dates are
        // allowed: device clocks drift and older entries cannot override newer ones.
        data.createdAt < request.time + duration.value(15, 'm') &&
        data.expiresAt <= request.time + duration.value(8, 'd') &&
        (!('createdByUid' in data) || data.createdByUid == request.auth.uid) &&
        data.householdId == householdId &&
        data.keys().hasAll(['householdId', 'category', 'message', 'createdAt', 'expiresAt', 'readBy', 'dismissedBy', 'audience']) &&
        data.keys().hasOnly([
          'householdId', 'category', 'title', 'message', 'createdAt', 'expiresAt',
          'deepLink', 'sourceType', 'sourceId', 'stateKey',
          'targetUserUid', 'readBy', 'dismissedBy', 'createdByUid',
          'audience'
        ]) &&
        data.category in ['chores', 'shopping', 'pets', 'maintenance', 'automation', 'system', 'general'] &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 120)) &&
        data.createdAt is timestamp &&
        data.expiresAt is timestamp &&
        data.readBy == {} &&
        data.dismissedBy == {} &&
        validDeepLink(data) &&
        validNotificationTarget(householdId, data) &&
        validNotificationAudience(data);
    }

    // Who read, dismissed or resolved a notification: `{ at, uid, displayName }`
    // (src/lib/notifications.ts createNotificationAction), never an email.
    function validNotificationAction(entry) {
      return entry is map && entry.keys().hasOnly(['at', 'uid', 'displayName']);
    }

    // The caller's own entry in `readBy` / `dismissedBy`, when this write sets it,
    // is an action entry; removing it (Undo) is allowed.
    function ownNotificationStateValid(after, before) {
      return !after.diff(before).affectedKeys().hasAny([request.auth.uid]) ||
        !(request.auth.uid in after) ||
        validNotificationAction(after[request.auth.uid]);
    }

    function updatesOnlyOwnNotificationState() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'dismissedBy']) &&
             request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]) &&
             request.resource.data.dismissedBy.diff(resource.data.dismissedBy).affectedKeys().hasOnly([request.auth.uid]) &&
             ownNotificationStateValid(request.resource.data.readBy, resource.data.readBy) &&
             ownNotificationStateValid(request.resource.data.dismissedBy, resource.data.dismissedBy);
    }

    function resolvesMaintenanceNotification() {
      return resource.data.category == 'maintenance' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt', 'resolvedBy']) &&
             validNotificationAction(request.resource.data.resolvedBy) &&
             request.resource.data.resolvedBy.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Attachments
    // ---------------------------------------------------------------------

    function validNewMaintenanceAttachment(householdId) {
      return request.resource.data.householdId == householdId &&
             request.resource.data.uploadedByUid == request.auth.uid &&
             request.resource.data.targetType in ['home_asset', 'vehicle', 'maintenance_log'] &&
             request.resource.data.category in ['photo', 'receipt', 'manual', 'warranty_document', 'invoice', 'other'] &&
             request.resource.data.filePath.matches('households/' + householdId + '/maintenance/.*') &&
             request.resource.data.keys().hasAll([
               'householdId',
               'targetType',
               'targetId',
               'category',
               'fileName',
               'filePath',
               'uploadedByUid',
               'createdAt'
             ]);
    }

    // ---------------------------------------------------------------------
    // Household content shapes
    //
    // Client writes to chores, chore templates, shopping lists and items, pet
    // logs, maintenance records and the barcode library must match the shapes
    // the app writes. Each allowlist is a superset of every field any shipped
    // client writes (including offline-queued writes from older releases).
    // Only the keys a write sets are checked: every key on create, and on update
    // only keys it adds or changes, so a document that still holds a legacy field
    // stays updatable on its other fields, and removing a field is always allowed.
    // Admin SDK writers (server upkeep, Cloud Functions) bypass these rules.
    // ---------------------------------------------------------------------

    function writtenKeys() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).addedKeys()
            .union(request.resource.data.diff(resource.data).changedKeys());
    }

    function boundedString(value, max) {
      return value is string && value.size() <= max;
    }

    function nonEmptyString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function optionalString(value, max) {
      return value == null || boundedString(value, max);
    }

    function boundedList(value, max) {
      return value is list && value.size() <= max;
    }

    function boundedNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function dateValue(value) {
      return value is timestamp || boundedString(value, 40);
    }

    // --- Device attribution (docs/modules/devices/README.md, section 12) ----
    // `deviceAttribution` (which tablet, which person, face or PIN) is written only by
    // the device actions on the server. No personal client may add it (every content
    // allow-list leaves it out), change it or remove it.
    function deviceAttributionKept() {
      return request.resource.data.get('deviceAttribution', null) == resource.data.get('deviceAttribution', null);
    }

    // Chores (S10): the attribution belongs to the completion, so an update that clears
    // the completion (isCompleted becomes false) may remove it, and only remove it.
    function choreDeviceAttributionKept() {
      return deviceAttributionKept() ||
        (!('deviceAttribution' in request.resource.data) &&
          resource.data.get('isCompleted', false) == true &&
          request.resource.data.get('isCompleted', false) != true);
    }

    // --- Chores -----------------------------------------------------------

    // Unassigned ('' or null) or the caller: no chores.assign needed.
    function choreAssigneeIsCallerOrNone(email) {
      return email == null || email == '' || email == request.auth.token.email;
    }

    // The uid assignee written alongside an email (older records). Without chores.assign
    // a uid is accepted only when it is verifiably the assignee the email names: none, or
    // the caller's own uid beside the caller's own email. Membership records carry no
    // email, so any other uid needs chores.assign.
    function choreAssigneeUidMatchesEmail(householdId, uid, email) {
      return uid == null || uid == '' ||
        (uid == request.auth.uid && email == request.auth.token.email);
    }

    // `uid` is the member of this household whom a stored legacy assignee email names:
    // their protected contact document holds that email (compared case-insensitively;
    // never an email left on a membership record). The rules read the contact
    // document themselves; the caller never sees it.
    function memberUidHasEmail(householdId, uid, email) {
      let member = /databases/$(database)/documents/households/$(householdId)/members/$(uid);
      let contact = /databases/$(database)/documents/households/$(householdId)/members/$(uid)/private/contact;
      return uid is string && uid != '' && email is string && email != '' && exists(member) &&
        exists(contact) && get(contact).data.get('email', '').lower() == email.lower();
    }

    // Release C writers replace a legacy assignee email by the uid of the member it
    // names, removing the email (and a template's recurrence copy) in the same write.
    // That keeps the assignee, so it needs no chores.assign: the email is removed and
    // the new uid belongs to the member the stored email named.
    function legacyAssigneeKept(householdId, after, before, beforeEmail) {
      return after.get('assignedToEmail', '') in [null, ''] &&
        memberUidHasEmail(householdId, after.get('assignedToUid', null), beforeEmail);
    }

    // Since member privacy release C writers store the uid alone (no email). Creating a
    // chore or setting a template for yourself that way needs no chores.assign, as with
    // your own email; any other uid is checked as above. Not used for chore updates:
    // changing a chore's assignee, even to yourself, still needs chores.assign.
    function choreAssigneeUidIsCallerOrMatches(householdId, uid, email) {
      return (uid == request.auth.uid && (email == null || email == '')) ||
        choreAssigneeUidMatchesEmail(householdId, uid, email);
    }

    function validChoreFields(data, keys) {
      return keys.hasOnly([
          'task', 'notes', 'assignedToEmail', 'assignedToUid', 'assignedToDisplayName', 'dueDate', 'originalDueDate',
          'roomIds', 'isCompleted', 'completedAt', 'completedAtServer', 'completedSubTasks', 'subTasks',
          'templateId', 'sourceType',
          // Server-written (H3): completion attribution and the generated occurrence's identity.
          'completedByUid', 'completedByEmail', 'completedByName', 'completionId', 'occurrenceKey'
        ]) &&
        (!('task' in keys) || nonEmptyString(data.task, 500)) &&
        (!('notes' in keys) || optionalString(data.notes, 5000)) &&
        (!('assignedToEmail' in keys) || optionalString(data.assignedToEmail, 320)) &&
        (!('assignedToUid' in keys) || optionalString(data.assignedToUid, 128)) &&
        (!('assignedToDisplayName' in keys) || optionalString(data.assignedToDisplayName, 200)) &&
        (!('dueDate' in keys) || boundedString(data.dueDate, 40)) &&
        (!('originalDueDate' in keys) || boundedString(data.originalDueDate, 40)) &&
        (!('roomIds' in keys) || boundedList(data.roomIds, 50)) &&
        (!('isCompleted' in keys) || data.isCompleted is bool) &&
        (!('completedAt' in keys) || optionalString(data.completedAt, 40)) &&
        (!('completedAtServer' in keys) || data.completedAtServer == null || data.completedAtServer is timestamp) &&
        (!('completedSubTasks' in keys) || boundedList(data.completedSubTasks, 100)) &&
        (!('subTasks' in keys) || boundedList(data.subTasks, 100)) &&
        (!('templateId' in keys) || boundedString(data.templateId, 300)) &&
        (!('sourceType' in keys) || data.sourceType in ['temporary', 'template']) &&
        (!('completedByUid' in keys) || optionalString(data.completedByUid, 128)) &&
        (!('completedByEmail' in keys) || optionalString(data.completedByEmail, 320)) &&
        (!('completedByName' in keys) || optionalString(data.completedByName, 200)) &&
        (!('completionId' in keys) || optionalString(data.completionId, 100)) &&
        (!('occurrenceKey' in keys) || boundedString(data.occurrenceKey, 700));
    }

    // Completion attribution (H3, rules stage R1). Who completed a chore and the
    // completion's id are written only by the completion server action (Admin SDK),
    // and a generated chore's occurrenceKey only by server upkeep: clients may not
    // set, change or remove them. Clients may still toggle isCompleted (older
    // releases complete with client writes) until stage R2 removes that.
    function choreServerFieldsAbsent() {
      return !request.resource.data.keys().hasAny(
        ['completedByUid', 'completedByEmail', 'completedByName', 'completionId', 'occurrenceKey']);
    }

    function choreServerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['completedByUid', 'completedByEmail', 'completedByName', 'completionId', 'occurrenceKey']);
    }

    // A client completion (older releases) must not leave another person's
    // attribution on the chore, or the points would go to them.
    function choreClientCompletionUnattributed() {
      return request.resource.data.get('isCompleted', false) != true ||
        resource.data.get('isCompleted', false) == true ||
        !request.resource.data.keys().hasAny(['completedByUid', 'completedByEmail', 'completedByName', 'completionId']);
    }

    // Creating a chore for someone else needs chores.assign; chores.create alone
    // covers a chore for yourself or an unassigned one.
    function choreCreateAssignmentAllowed(householdId) {
      return (choreAssigneeIsCallerOrNone(request.resource.data.get('assignedToEmail', null)) &&
          choreAssigneeUidIsCallerOrMatches(householdId, request.resource.data.get('assignedToUid', null),
            request.resource.data.get('assignedToEmail', null))) ||
        hasHouseholdPermission(householdId, 'chores.assign');
    }

    // Any change of a chore's assignee needs chores.assign.
    // Filling in (or correcting) the uid of the assignee already named by email is not a
    // reassignment, as long as the uid verifiably belongs to that email; any other change
    // of the assignee needs chores.assign.
    function choreReassignmentAllowed(householdId) {
      let after = request.resource.data;
      let before = resource.data;
      return (after.get('assignedToEmail', null) == before.get('assignedToEmail', null) &&
          (after.get('assignedToUid', null) == before.get('assignedToUid', null) ||
            choreAssigneeUidMatchesEmail(householdId, after.get('assignedToUid', null), after.get('assignedToEmail', null)))) ||
        legacyAssigneeKept(householdId, after, before, before.get('assignedToEmail', null)) ||
        hasHouseholdPermission(householdId, 'chores.assign');
    }

    // --- Chore templates --------------------------------------------------

    function validMonthlyOptions(value) {
      return value is map &&
        value.keys().hasOnly(['mode', 'dayOfMonth', 'nthWeekday']) &&
        (!('mode' in value) || value.mode in ['dayOfMonth', 'nthWeekday']) &&
        (!('dayOfMonth' in value) || boundedNumber(value.dayOfMonth, 1, 31)) &&
        (!('nthWeekday' in value) ||
          (value.nthWeekday is map && value.nthWeekday.keys().hasOnly(['week', 'dayOfWeek'])));
    }

    function validRecurrence(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly([
          'frequency', 'interval', 'assignedToEmail', 'startDate', 'dailyOptions', 'weeklyOptions', 'monthlyOptions'
        ]) &&
        value.get('frequency', null) in ['daily', 'weekly', 'biweekly', 'monthly'] &&
        (!('interval' in value) || boundedNumber(value.interval, 1, 52)) &&
        (!('assignedToEmail' in value) || optionalString(value.assignedToEmail, 320)) &&
        (!('startDate' in value) || optionalString(value.startDate, 40)) &&
        (!('dailyOptions' in value) ||
          (value.dailyOptions is map && value.dailyOptions.keys().hasOnly(['excludeWeekends']))) &&
        (!('weeklyOptions' in value) ||
          (value.weeklyOptions is map && value.weeklyOptions.keys().hasOnly(['daysOfWeek']) &&
            boundedList(value.weeklyOptions.get('daysOfWeek', []), 7))) &&
        (!('monthlyOptions' in value) || validMonthlyOptions(value.monthlyOptions))
      );
    }

    function validChoreTemplateFields(data, keys) {
      return keys.hasOnly(['task', 'notes', 'roomIds', 'subTasks', 'recurrence', 'assignedToEmail', 'assignedToUid']) &&
        (!('task' in keys) || nonEmptyString(data.task, 500)) &&
        (!('notes' in keys) || optionalString(data.notes, 5000)) &&
        (!('roomIds' in keys) || boundedList(data.roomIds, 50)) &&
        (!('subTasks' in keys) || boundedList(data.subTasks, 100)) &&
        (!('recurrence' in keys) || validRecurrence(data.recurrence)) &&
        (!('assignedToEmail' in keys) || optionalString(data.assignedToEmail, 320)) &&
        (!('assignedToUid' in keys) || optionalString(data.assignedToUid, 128));
    }

    function recurrenceAssignee(data) {
      return data.get('recurrence', null) is map ? data.recurrence.get('assignedToEmail', null) : null;
    }

    // A template is assigned through `assignedToUid` (and, on older templates,
    // `assignedToEmail` and `recurrence.assignedToEmail`).
    // Setting either to someone other than the caller needs chores.assign.
    function templateAssignmentAllowed(householdId) {
      let after = request.resource.data;
      let before = resource == null ? {} : resource.data;
      return (
          (after.get('assignedToEmail', null) == before.get('assignedToEmail', null) ||
            choreAssigneeIsCallerOrNone(after.get('assignedToEmail', null))) &&
          (recurrenceAssignee(after) == recurrenceAssignee(before) ||
            choreAssigneeIsCallerOrNone(recurrenceAssignee(after))) &&
          (after.get('assignedToUid', null) == before.get('assignedToUid', null) ||
            choreAssigneeUidIsCallerOrMatches(householdId, after.get('assignedToUid', null), after.get('assignedToEmail', null)) ||
            // The stored legacy email (top level, else the recurrence copy) is replaced by
            // the uid of the member it names; both email copies end up removed.
            (recurrenceAssignee(after) in [null, ''] &&
              legacyAssigneeKept(householdId, after, before,
                before.get('assignedToEmail', '') in [null, ''] ? recurrenceAssignee(before) : before.get('assignedToEmail', null))))
        ) ||
        hasHouseholdPermission(householdId, 'chores.assign');
    }

    // --- Shopping ---------------------------------------------------------

    // storeId (the store whose aisle order the list uses, or none) and createdByUid
    // (the creator: the writer, set only on create, then neither changed nor
    // removed) are optional, so lists of older clients stay valid and editable;
    // their merge writes leave both untouched.
    function validShoppingListFields(data, keys) {
      return keys.hasOnly(['name', 'description', 'icon', 'type', 'color', 'storeId', 'createdByUid']) &&
        (!('name' in keys) || nonEmptyString(data.name, 100)) &&
        (!('description' in keys) || optionalString(data.description, 500)) &&
        (!('icon' in keys) || boundedString(data.icon, 64)) &&
        (!('type' in keys) || boundedString(data.type, 40)) &&
        (!('color' in keys) || optionalString(data.color, 64)) &&
        (!('storeId' in keys) || optionalString(data.storeId, 200)) &&
        (!('createdByUid' in keys) || (resource == null && data.createdByUid == request.auth.uid)) &&
        (resource == null || data.get('createdByUid', null) == resource.data.get('createdByUid', null));
    }

    // quantity is checked after any increment() is applied. nameKey, addedByUid,
    // restoredByUid, categorySource, size and sizeUnit (S2 save paths) and the S3
    // stamps (validShoppingItemStamps) are optional, so items
    // written by older clients stay valid; addedByUid is checked on create and
    // frozen on update below. size is a package size (BL-1), never the count.
    function validShoppingItemFields(data, keys) {
      return keys.hasOnly(['name', 'quantity', 'category', 'createdAt', 'status', 'imageUrl', 'barcode', 'sourceUrl',
          'nameKey', 'addedByUid', 'restoredByUid', 'categorySource', 'size', 'sizeUnit',
          'purchasedByUid', 'purchasedAt', 'purchaseOpId', 'undoOpId', 'restoreOpId', 'restoredAt', 'editedByUid', 'editedAt']) &&
        (!('nameKey' in keys) || nonEmptyString(data.nameKey, 500)) &&
        (!('addedByUid' in keys) || nonEmptyString(data.addedByUid, 128)) &&
        (!('restoredByUid' in keys) || nonEmptyString(data.restoredByUid, 128)) &&
        (!('categorySource' in keys) || data.categorySource in ['manual', 'remembered', 'local', 'ai', 'fallback', 'pending']) &&
        (!('size' in keys) || (data.size is number && data.size > 0 && data.size <= 100000)) &&
        (!('sizeUnit' in keys) || nonEmptyString(data.sizeUnit, 16)) &&
        (!('name' in keys) || nonEmptyString(data.name, 500)) &&
        (!('quantity' in keys) || (data.quantity is number && data.quantity > 0 && data.quantity <= 100000)) &&
        (!('category' in keys) || boundedString(data.category, 100)) &&
        (!('createdAt' in keys) || dateValue(data.createdAt)) &&
        (!('status' in keys) || data.status in ['needed', 'purchased']) &&
        (!('imageUrl' in keys) || boundedString(data.imageUrl, 2048)) &&
        (!('barcode' in keys) || boundedString(data.barcode, 128)) &&
        (!('sourceUrl' in keys) || boundedString(data.sourceUrl, 2048));
    }

    // S3 tick, edit and Undo stamps (checked on written keys only, so items of
    // older clients stay valid and editable):
    // - purchasedByUid is the writer or null, purchasedAt the server's time or null
    //   (and a set purchasedAt is the writer's own purchase);
    // - editedByUid is the writer and comes with editedAt == request.time;
    // - undoOpId (the Undo of a tick) only while the stored purchaseOpId is that
    //   id, unchanged by the same write, and only back to needed: a newer tick by
    //   anyone writes a new purchaseOpId (and removes undoOpId), so a late Undo is
    //   refused instead of overwriting it;
    // - restoreOpId (the Undo of a delete) only on a create, so a restore never
    //   overwrites an item that exists again (see shoppingRestoreCreate); once set,
    //   restoreOpId and restoredAt are frozen (neither changed nor removed), so a
    //   second tab replaying the same restore (same restoreOpId) is refused whether
    //   its restoredAt resolves to a new time or is left out.
    function validShoppingItemStamps(data, keys) {
      return (!('purchasedByUid' in keys) || data.purchasedByUid == null || data.purchasedByUid == request.auth.uid) &&
        (!('purchasedAt' in keys) || data.purchasedAt == null ||
          (data.purchasedAt == request.time && data.get('purchasedByUid', null) == request.auth.uid)) &&
        (!('purchaseOpId' in keys) || nonEmptyString(data.purchaseOpId, 64)) &&
        (!('editedByUid' in keys) || (data.editedByUid == request.auth.uid && 'editedAt' in keys)) &&
        (!('editedAt' in keys) || (data.editedAt == request.time && data.get('editedByUid', null) == request.auth.uid)) &&
        (!('undoOpId' in keys) || shoppingUndoMatchesPurchase(data, keys)) &&
        (!('restoreOpId' in keys) || (resource == null && nonEmptyString(data.restoreOpId, 64))) &&
        (!('restoredAt' in keys) || (resource == null && 'restoreOpId' in data)) &&
        (resource != null || !('restoreOpId' in data) || shoppingRestoreCreate(data)) &&
        (resource == null || (shoppingRestoreStampsKept(data) && shoppingServerFieldsKept(data)));
    }

    // pantryCreditedAt and creditTripId are written only by the server's put-away
    // (Admin SDK): a client may never set them (validShoppingItemFields does not
    // list them, so a create carrying them is refused), change them or remove them.
    function shoppingServerFieldsKept(data) {
      return data.get('pantryCreditedAt', null) == resource.data.get('pantryCreditedAt', null) &&
        data.get('creditTripId', null) == resource.data.get('creditTripId', null);
    }

    // On an update, the stored restore stamps stay exactly as they are: a write that
    // removes restoredAt (a stale restore payload without it) or changes either one
    // is refused. Items never restored have neither, and an update may not add them.
    function shoppingRestoreStampsKept(data) {
      return data.get('restoreOpId', null) == resource.data.get('restoreOpId', null) &&
        data.get('restoredAt', null) == resource.data.get('restoredAt', null);
    }

    // A restore (create with restoreOpId) carries restoredByUid = the writer and
    // restoredAt == request.time, and none of the purchase, edit or Undo stamps:
    // those belong to their own writer and time, so a restored item keeps its status
    // (and purchaseOpId) but not purchasedByUid/At, editedByUid/At or undoOpId.
    // restoredAt is what makes a restore create-only even when it is replayed: a
    // setDoc of the same payload onto an item that exists again resolves restoredAt
    // to a new request.time, so it is a changed key on an update and refused above,
    // while ordinary updates leave restoredAt untouched.
    function shoppingRestoreCreate(data) {
      return data.get('restoredByUid', null) == request.auth.uid &&
        data.get('restoredAt', null) == request.time &&
        !data.keys().hasAny(['purchasedByUid', 'purchasedAt', 'editedByUid', 'editedAt', 'undoOpId']);
    }

    function shoppingUndoMatchesPurchase(data, keys) {
      return resource != null &&
        nonEmptyString(data.undoOpId, 64) &&
        data.get('status', null) == 'needed' &&
        !('purchaseOpId' in keys) &&
        resource.data.get('purchaseOpId', null) == data.undoOpId;
    }

    // Who added an item: the writer's own uid on create (or none, for older clients).
    // Undo of a delete re-creates someone else's item: then addedByUid may name another
    // member of this household as long as restoredByUid is the writer, so the restore
    // keeps the original attribution and records who restored it (an item without
    // addedByUid, from an older client, may be restored too). Never changed later.
    function shoppingAdderOnCreate(householdId) {
      let data = request.resource.data;
      let adder = data.get('addedByUid', null);
      let restorer = data.get('restoredByUid', null);
      return (restorer == null && (adder == null || adder == request.auth.uid)) ||
        (restorer == request.auth.uid &&
          (adder == null || adder == request.auth.uid ||
            exists(/databases/$(database)/documents/households/$(householdId)/members/$(adder))));
    }

    function shoppingAdderUnchanged() {
      return request.resource.data.get('addedByUid', null) == resource.data.get('addedByUid', null) &&
        request.resource.data.get('restoredByUid', null) == resource.data.get('restoredByUid', null);
    }

    // list: the categories as older clients write them (rewritten whole). ordered:
    // the categories in aisle order, added and removed with arrayUnion/arrayRemove
    // and reordered in a transaction; checked after the transform is applied.
    // Rules cannot inspect list elements, so the app keeps each entry a string of at
    // most 100 characters (the item category bound).
    function validShoppingConfig(data, keys) {
      return keys.hasOnly(['list', 'ordered']) &&
        (!('list' in keys) || boundedList(data.list, 200)) &&
        (!('ordered' in keys) || boundedList(data.ordered, 200));
    }

    // The parent list document of an item or category write (one document read).
    function shoppingListExists(householdId, listId) {
      return exists(/databases/$(database)/documents/households/$(householdId)/shopping-lists/$(listId));
    }

    // --- Pantry (Pantry v2, stage S4a) ------------------------------------

    // One document per batch. Both shapes are accepted while older pages are still
    // open: v2 fields (nameKey, packages, packageSize, date-only expiryDate,
    // attribution, updatedAt, schemaVersion) and the legacy quantity and ISO
    // expiry, which v2 clients dual-write. packages and quantity are checked after
    // any increment() is applied, so a "used one" can never go below zero. Stage
    // S4b (later) accepts only a date-only or null expiryDate.
    function validPantryExpiry(value) {
      return value == null ||
        (value is string && (value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') ||
          (value.size() <= 40 && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*'))));
    }

    function validPantryFields(data, keys) {
      return keys.hasOnly([
          'name', 'nameKey', 'location', 'unit', 'packages', 'packageSize', 'quantity', 'expiryDate',
          'barcode', 'addedByUid', 'updatedByUid', 'updatedAt', 'schemaVersion'
        ]) &&
        // Names are at most 120 characters, the recipe flow's limit; older longer names stay
        // editable on other fields because only written keys are checked.
        (!('name' in keys) || nonEmptyString(data.name, 120)) &&
        (!('nameKey' in keys) || boundedString(data.nameKey, 500)) &&
        (!('location' in keys) || data.location in ['Pantry', 'Fridge', 'Freezer']) &&
        (!('unit' in keys) || data.unit in ['g', 'kg', 'oz', 'lbs', 'ml', 'L', 'fl oz', 'items', 'cans', 'bottles', 'pieces', 'slices']) &&
        (!('packages' in keys) || boundedNumber(data.packages, 0, 10000)) &&
        (!('packageSize' in keys) || data.packageSize == null ||
          (data.packageSize is number && data.packageSize > 0 && data.packageSize <= 100000)) &&
        (!('quantity' in keys) || boundedNumber(data.quantity, 0, 100000)) &&
        (!('expiryDate' in keys) || validPantryExpiry(data.expiryDate)) &&
        (!('barcode' in keys) || optionalString(data.barcode, 128)) &&
        // Who added a batch: the creator, set only on create (pantryAdderUnchanged
        // keeps it fixed, and not removable, on update).
        (!('addedByUid' in keys) || (resource == null && data.addedByUid == request.auth.uid)) &&
        (!('updatedByUid' in keys) || data.updatedByUid == request.auth.uid) &&
        (!('updatedAt' in keys) || data.updatedAt == request.time) &&
        (!('schemaVersion' in keys) || data.schemaVersion == 2);
    }

    function pantryAdderUnchanged() {
      return request.resource.data.get('addedByUid', null) == resource.data.get('addedByUid', null);
    }

    // An older page's update: it changes only legacy fields and removes nothing.
    // Allowed in stage S4a on any batch, v2 included (a legacy quantity or name
    // edit leaves packages and the v2 attribution as they were; v2 pages read
    // packages, not quantity). Stage S4b drops this exception.
    function pantryLegacyOnlyUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return diff.removedKeys().size() == 0 &&
        diff.addedKeys().union(diff.changedKeys()).hasOnly(['name', 'quantity', 'unit', 'location', 'expiryDate']);
    }

    // Every other update (it changes a v2 field such as packages, or removes a
    // field) must leave the RESULTING batch attributed to this writer at this
    // time, so nobody can change a count under another member's updatedByUid or
    // an old updatedAt, or strip the attribution. Checked on the resulting
    // document because writtenKeys() only sees keys that changed.
    function pantryUpdateAttributed() {
      return pantryLegacyOnlyUpdate() ||
        (request.resource.data.get('updatedByUid', null) == request.auth.uid &&
          request.resource.data.get('updatedAt', null) == request.time);
    }

    // --- Pet logs ---------------------------------------------------------

    // Entries written before "who logged it" existed carry neither field, so both
    // stay optional; when present, the uid is the writer's and a name never
    // comes without it. Neither may change afterwards.
    function petLoggerOnCreate() {
      let data = request.resource.data;
      return (!('loggedByUid' in data) || data.loggedByUid == request.auth.uid) &&
        (!('loggedByName' in data) || ('loggedByUid' in data && optionalString(data.loggedByName, 200)));
    }

    function petLoggerUnchanged() {
      return request.resource.data.get('loggedByUid', null) == resource.data.get('loggedByUid', null) &&
        request.resource.data.get('loggedByName', null) == resource.data.get('loggedByName', null);
    }

    // `loggedAt`, `repeat`, `clockSource`, `backdated` and `confirmOf` come from the
    // shared feed operation (src/lib/pets/feed-transaction.ts); `originalDate` and
    // `dateCorrected*` from a time correction (PE-5e). Stage R2 requires the
    // operation's fields on every new feeding (feedingCreateR2).
    function validFeedingLogFields(data, keys) {
      return keys.hasOnly(['date', 'cups', 'foodType', 'foodAmountType', 'comments', 'ampm', 'loggedByUid', 'loggedByName',
          'loggedAt', 'repeat', 'clockSource', 'backdated', 'confirmOf', 'slotId',
          'originalDate', 'dateCorrectedAt', 'dateCorrectedByUid', 'dateCorrectedByName']) &&
        (!('date' in keys) || dateValue(data.date)) &&
        (!('slotId' in keys) || mealSlotId(data.slotId)) &&
        (!('confirmOf' in keys) || data.confirmOf == null || nonEmptyString(data.confirmOf, 200)) &&
        (!('originalDate' in keys) || data.originalDate == null || dateValue(data.originalDate)) &&
        (!('dateCorrectedAt' in keys) || data.dateCorrectedAt is timestamp) &&
        (!('dateCorrectedByUid' in keys) || nonEmptyString(data.dateCorrectedByUid, 128)) &&
        (!('dateCorrectedByName' in keys) || optionalString(data.dateCorrectedByName, 200)) &&
        (!('loggedAt' in keys) || data.loggedAt is timestamp) &&
        (!('repeat' in keys) || data.repeat in ['none', 'confirmed', 'offline']) &&
        (!('clockSource' in keys) || data.clockSource in ['device', 'server']) &&
        (!('backdated' in keys) || data.backdated is bool) &&
        (!('cups' in keys) || boundedNumber(data.cups, 0, 1000)) &&
        (!('foodType' in keys) || boundedString(data.foodType, 40)) &&
        (!('foodAmountType' in keys) || boundedString(data.foodAmountType, 40)) &&
        (!('comments' in keys) || optionalString(data.comments, 2000)) &&
        (!('ampm' in keys) || data.ampm in ['AM', 'PM']);
    }

    // writtenKeys() without its `resource == null ? ... : diff(resource.data)`
    // branch, which the emulator reports as an evaluation error on every denied
    // write. Feeding logs and the feeding state use these instead.
    function createdKeys() {
      return request.resource.data.keys().toSet();
    }

    function updatedKeys() {
      return request.resource.data.diff(resource.data).addedKeys()
        .union(request.resource.data.diff(resource.data).changedKeys());
    }

    // loggedAt is the server time of the write (it opens the author's 10-minute
    // delete window), so it can't be chosen on create or changed afterwards.
    function feedingLoggedAtOnCreate() {
      return !('loggedAt' in request.resource.data) || request.resource.data.loggedAt == request.time;
    }

    function feedingLoggedAtUnchanged() {
      return request.resource.data.get('loggedAt', null) == resource.data.get('loggedAt', null);
    }

    // PE-2: whoever logged a feeding may delete it for 10 minutes (Undo for
    // everyone who can log), besides members with pets.deleteLogs.
    function feedingAuthorWithinUndoWindow(householdId) {
      return hasHouseholdPermission(householdId, 'pets.addLogs') &&
        resource.data.get('loggedByUid', null) == request.auth.uid &&
        resource.data.get('loggedAt', null) is timestamp &&
        request.time < resource.data.loggedAt + duration.value(10, 'm');
    }

    // --- Feeding rules, stage R2 (PE-23f/g/h, PE-5e) -----------------------
    // A device clock may run ahead of the server: a device-chosen time (an
    // offline feed, a backdated entry, a corrected time) may be at most this far
    // in the future, the readers' clock-skew allowance (FEEDING_CLOCK_SKEW_MS).
    function feedingDeviceTime(value) {
      return value is timestamp && value <= request.time + duration.value(12, 'h');
    }

    function feedingStatePath(householdId, petId) {
      return /databases/$(database)/documents/households/$(householdId)/pets/$(petId)/feeding-state/current;
    }

    // The state before this write, or null without one.
    function feedingStateBefore(householdId, petId) {
      return exists(feedingStatePath(householdId, petId)) ? get(feedingStatePath(householdId, petId)).data : null;
    }

    // The stored latest feed is under 90 minutes old and its log still exists
    // (a latest feed deleted offline is not a feed, as the client reads it).
    function feedingRecent(householdId, petId, before) {
      return before != null &&
        before.get('lastLogId', null) is string &&
        before.get('lastFedAt', null) is timestamp &&
        request.time < before.lastFedAt + duration.value(90, 'm') &&
        exists(feedingLogPath(householdId, petId, before.lastLogId));
    }

    // Today's planned feedings are already logged: the count after this feed is
    // above the pet's structured feedingsPerDay. (A plan read from the free-text
    // schedule is checked by the client transaction only.)
    function feedingDayComplete(householdId, petId) {
      let pet = get(/databases/$(database)/documents/households/$(householdId)/pets/$(petId)).data;
      let perDay = pet.get('feedingsPerDay', null);
      return perDay is int && perDay > 0 &&
        getAfter(feedingStatePath(householdId, petId)).data.get('countOnDay', 0) > perDay;
    }

    // "Feed again?" bound to what was shown (PE-23g): the confirmation names the
    // last feeding the member was asked about. It must be the state's latest feed,
    // or a feeding at least as new by effective time (`date`, when the pet ate:
    // one synced from offline after the state was written, or one whose time was
    // corrected to after the state's latest), the same notion the client's
    // planFeed uses to pick the last feed. A confirmation shown before a newer feed
    // by someone else names an older log and is refused. Without a surviving
    // latest feed nothing is bound.
    function feedingConfirmBound(householdId, petId, data, before) {
      let latest = before == null ? null : before.get('lastLogId', null);
      let confirmOf = data.get('confirmOf', null);
      return !(latest is string) ||
        !exists(feedingLogPath(householdId, petId, latest)) ||
        confirmOf == latest ||
        (confirmOf is string &&
          exists(feedingLogPath(householdId, petId, confirmOf)) &&
          get(feedingLogPath(householdId, petId, confirmOf)).data.get('date', null) is timestamp &&
          before.get('lastFedAt', null) is timestamp &&
          feedingNow(get(feedingLogPath(householdId, petId, confirmOf)).data.date) >= feedingNow(before.lastFedAt));
    }

    // A feeding's effective time as the rules compare feedings: its stored
    // `date`, where a time ahead of the server clock (a device clock running
    // ahead, within the 12-hour allowance) counts as now. A live feed written now
    // is therefore never "older" than a feeding that synced from a fast clock,
    // so supported skew never blocks a feed. The client orders by the stored
    // date with a live feed first (isNameableFeedingDate in feed-decision.ts),
    // which this comparison always accepts.
    function feedingNow(at) {
      return at > request.time ? request.time : at;
    }

    // --- Meal slots on feedings (P2, D-P5) ----------------------------------
    // A feeding's `slotId` names a slot of the pet's current plan. A live,
    // unconfirmed feeding for a slot replaces the 90-minute and complete-day
    // checks with the slot one: the state's `slotsFed` (slot id -> first log id
    // of the state's day) must record this log for its slot, and the slot must
    // not already be fed that day by a log that still exists. What only the
    // client checks: whether the slot's window is open (household-local times),
    // off-days, and feedings without a slot attributed to a slot by time.
    function petMealSlots(householdId, petId) {
      let pet = get(/databases/$(database)/documents/households/$(householdId)/pets/$(petId)).data;
      let plan = pet.get('mealPlan', null);
      return plan is map && plan.get('slots', null) is list ? plan.slots : [];
    }

    function mealSlotIn(slots, slotId) {
      return (slots.size() > 0 && slots[0].get('id', null) == slotId) ||
        (slots.size() > 1 && slots[1].get('id', null) == slotId) ||
        (slots.size() > 2 && slots[2].get('id', null) == slotId) ||
        (slots.size() > 3 && slots[3].get('id', null) == slotId) ||
        (slots.size() > 4 && slots[4].get('id', null) == slotId) ||
        (slots.size() > 5 && slots[5].get('id', null) == slotId);
    }

    function feedingSlotKnown(householdId, petId, data) {
      return !('slotId' in data) || mealSlotIn(petMealSlots(householdId, petId), data.slotId);
    }

    function feedingSlotFree(householdId, petId, logId, slotId, before) {
      let after = getAfter(feedingStatePath(householdId, petId)).data;
      let fedBefore = before == null ? {} : before.get('slotsFed', {});
      return after.get('slotsFed', {}) is map &&
        after.get('slotsFed', {}).get(slotId, null) == logId &&
        !(before != null &&
          before.get('day', null) == after.get('day', null) &&
          fedBefore is map &&
          fedBefore.get(slotId, null) is string &&
          exists(feedingLogPath(householdId, petId, fedBefore.get(slotId, ''))));
    }

    // Every new feeding (stage R2): signed by the writer, recorded at server time,
    // and one of:
    // - live: `date` is server time, written with the state in the same commit
    //   (the state's latest feed is this log), and a repeat within 90 minutes of
    //   the state's latest feed or past a complete day needs `repeat: 'confirmed'`
    //   with a confirmation bound to the current state;
    // - offline (live or backdated): queued with the device clock (`clockSource:
    //   'device'`), no state write (the next online writer reconciles), never
    //   further ahead than the clock-skew allowance;
    // - backdated: a deliberately chosen earlier time, no repeat check.
    // A create over an existing id is an update and is refused (feedingCorrected
    // is the only update), so one press is one feeding (PE-23h).
    function feedingCreateR2(householdId, petId, logId) {
      let data = request.resource.data;
      let before = feedingStateBefore(householdId, petId);
      return data.get('loggedByUid', null) == request.auth.uid &&
        data.get('loggedAt', null) == request.time &&
        feedingSlotKnown(householdId, petId, data) &&
        !('originalDate' in data) && !('dateCorrectedAt' in data) &&
        !('dateCorrectedByUid' in data) && !('dateCorrectedByName' in data) &&
        (
          (data.get('repeat', null) == 'offline' &&
            data.get('clockSource', null) == 'device' &&
            feedingDeviceTime(data.date)) ||
          (data.get('backdated', false) == true &&
            data.get('repeat', null) == 'none' &&
            feedingDeviceTime(data.date)) ||
          (data.get('backdated', false) == false &&
            data.get('repeat', null) in ['none', 'confirmed'] &&
            !('clockSource' in data) &&
            data.date == request.time &&
            existsAfter(feedingStatePath(householdId, petId)) &&
            getAfter(feedingStatePath(householdId, petId)).data.get('lastLogId', null) == logId &&
            (data.repeat == 'confirmed'
              ? feedingConfirmBound(householdId, petId, data, before)
              : ('slotId' in data
                ? feedingSlotFree(householdId, petId, logId, data.slotId, before)
                : !feedingRecent(householdId, petId, before) && !feedingDayComplete(householdId, petId))))
        );
    }

    // Correcting a feeding's effective time (PE-5e): only `date` (and its `ampm`)
    // change, to a timestamp no further ahead than the clock-skew allowance; the
    // first correction keeps the original in `originalDate` (immutable after),
    // every correction records who and when. `loggedAt` and the author never
    // change. Its author may do it for 10 minutes after `loggedAt`, members with
    // pets.deleteLogs at any time.
    function feedingCorrected(householdId) {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['date', 'ampm', 'originalDate', 'dateCorrectedAt', 'dateCorrectedByUid', 'dateCorrectedByName']) &&
        feedingDeviceTime(after.date) &&
        after.get('dateCorrectedAt', null) == request.time &&
        after.get('dateCorrectedByUid', null) == request.auth.uid &&
        ('originalDate' in before
          ? after.get('originalDate', null) == before.originalDate
          : after.get('originalDate', null) == before.get('date', null)) &&
        (hasHouseholdPermission(householdId, 'pets.deleteLogs') ||
          feedingAuthorWithinUndoWindow(householdId));
    }

    // --- Meal plans on the pet (P2: PE-22a, PE-22g, PE-22k) ------------------
    // `mealPlan` holds up to 6 slots with stable ids, household-local `HH:mm`
    // times, a portion and optional off-days; it is written by the confirming
    // member at server time. Editing it keeps the plan that applied before in
    // `mealPlanHistory` (oldest first, at most 10): a later `effectiveFrom`
    // appends exactly the replaced slots (`until` = the new `effectiveFrom`) and
    // keeps every earlier entry; a same-day edit leaves the history alone; a
    // first plan may record the legacy target it replaces. A plan cannot be
    // removed. Other pet fields are not validated here (unchanged from 2.1).
    function mealSlotId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,32}$');
    }

    function validMealSlot(slot) {
      return slot is map &&
        slot.keys().hasOnly(['id', 'name', 'time', 'amount', 'unit', 'offDays']) &&
        slot.keys().hasAll(['id', 'name', 'time', 'amount', 'unit']) &&
        mealSlotId(slot.id) &&
        slot.name is string && slot.name.size() >= 1 && slot.name.size() <= 30 &&
        slot.time is string && slot.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        (slot.amount is int || slot.amount is float) && slot.amount > 0 && slot.amount <= 50 &&
        slot.unit in ['Cups', 'Cans', 'Scoops', 'Other'] &&
        (!('offDays' in slot) ||
          (slot.offDays is list && slot.offDays.size() <= 6 && slot.offDays.hasOnly([0, 1, 2, 3, 4, 5, 6])));
    }

    function mealSlotValidAt(slots, i) {
      return slots.size() <= i || validMealSlot(slots[i]);
    }

    // A slot's id or time, or a placeholder unique to the index when there is no slot there.
    function mealSlotKeyAt(slots, i, field) {
      return slots.size() > i ? slots[i][field] : '#' + field + string(i);
    }

    function validMealSlots(slots) {
      return slots is list && slots.size() >= 1 && slots.size() <= 6 &&
        mealSlotValidAt(slots, 0) && mealSlotValidAt(slots, 1) && mealSlotValidAt(slots, 2) &&
        mealSlotValidAt(slots, 3) && mealSlotValidAt(slots, 4) && mealSlotValidAt(slots, 5) &&
        [mealSlotKeyAt(slots, 0, 'id'), mealSlotKeyAt(slots, 1, 'id'), mealSlotKeyAt(slots, 2, 'id'),
          mealSlotKeyAt(slots, 3, 'id'), mealSlotKeyAt(slots, 4, 'id'), mealSlotKeyAt(slots, 5, 'id')].toSet().size() == 6 &&
        [mealSlotKeyAt(slots, 0, 'time'), mealSlotKeyAt(slots, 1, 'time'), mealSlotKeyAt(slots, 2, 'time'),
          mealSlotKeyAt(slots, 3, 'time'), mealSlotKeyAt(slots, 4, 'time'), mealSlotKeyAt(slots, 5, 'time')].toSet().size() == 6;
    }

    function validMealPlan(plan) {
      return plan is map &&
        plan.keys().hasOnly(['slots', 'effectiveFrom', 'confirmedAt', 'confirmedByUid', 'confirmedByName']) &&
        plan.keys().hasAll(['slots', 'effectiveFrom', 'confirmedAt', 'confirmedByUid']) &&
        validMealSlots(plan.slots) &&
        plan.effectiveFrom is string && plan.effectiveFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        plan.confirmedAt == request.time &&
        plan.confirmedByUid == request.auth.uid &&
        (!('confirmedByName' in plan) || optionalString(plan.confirmedByName, 200));
    }

    // The legacy daily target a first plan replaces.
    function legacyMealPlanEntry(entry, until) {
      return entry is map && entry.keys().hasOnly(['until', 'perDay', 'nonDaily']) && entry.get('until', null) == until &&
        (entry.get('perDay', null) == null || (entry.perDay is int && entry.perDay >= 1 && entry.perDay <= 12)) &&
        (!('nonDaily' in entry) || entry.nonDaily is bool);
    }

    function mealPlanWrite(before, after) {
      let plan = after.get('mealPlan', null);
      let history = after.get('mealPlanHistory', []);
      let previous = before == null ? null : before.get('mealPlan', null);
      let past = before == null ? [] : before.get('mealPlanHistory', []);
      return validMealPlan(plan) && history is list && history.size() <= 10 &&
        (previous == null
          ? (history.size() == 0 || (history.size() == 1 && legacyMealPlanEntry(history[0], plan.effectiveFrom)))
          : (plan.effectiveFrom == previous.get('effectiveFrom', null)
            ? history == past
            : (plan.effectiveFrom > previous.get('effectiveFrom', '') &&
              history.size() >= 1 &&
              history[history.size() - 1] == {'until': plan.effectiveFrom, 'slots': previous.get('slots', null)} &&
              ((history.size() == past.size() + 1 && history[0:history.size() - 1] == past) ||
                (history.size() == 10 && past.size() == 10 && history[0:9] == past[1:10])))));
    }

    function petMealPlanCreate() {
      return !request.resource.data.keys().hasAny(['mealPlan', 'mealPlanHistory']) ||
        mealPlanWrite(null, request.resource.data);
    }

    function petMealPlanUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mealPlan', 'mealPlanHistory']) ||
        mealPlanWrite(resource.data, request.resource.data);
    }

    // --- Feeding state (households/{h}/pets/{p}/feeding-state/current) ----
    // The shared feed operation keeps the latest feed and the household day's
    // count here, written in the same transaction as the log it describes.

    function feedingStateDay(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function feedingStateLatest(data) {
      return (data.get('lastLogId', null) == null || nonEmptyString(data.lastLogId, 200)) &&
        (data.get('lastFedAt', null) == null || data.lastFedAt is timestamp) &&
        optionalString(data.get('lastFedByUid', null), 128) &&
        optionalString(data.get('lastFedByName', null), 200) &&
        feedingStateDay(data.get('day', null)) &&
        data.get('countOnDay', 0) is int && data.get('countOnDay', 0) >= 0 && data.get('countOnDay', 0) <= 1000;
    }

    function validFeedingState(data) {
      let fields = ['lastLogId', 'lastFedAt', 'lastFedByUid', 'lastFedByName', 'day', 'countOnDay'];
      return data.keys().hasOnly(fields.concat(['prev', 'slotsFed'])) && data.keys().hasAll(fields) &&
        feedingStateLatest(data) &&
        (!('slotsFed' in data) || (data.slotsFed is map && data.slotsFed.size() <= 20)) &&
        (data.get('prev', null) == null ||
          (data.prev is map && data.prev.keys().hasOnly(fields) && feedingStateLatest(data.prev)));
    }

    function feedingLogPath(householdId, petId, logId) {
      return /databases/$(database)/documents/households/$(householdId)/pets/$(petId)/feeding-logs/$(logId);
    }

    // The feeding state names real feedings: a feeding it names is a log that
    // exists once this write commits, with that log's own effective time
    // (`date`, a timestamp), author and name; or nothing (all four null).
    function feedingStateNames(householdId, petId, id, at, uid, name) {
      return (id == null && at == null && uid == null && name == null) ||
        (id is string &&
          existsAfter(feedingLogPath(householdId, petId, id)) &&
          getAfter(feedingLogPath(householdId, petId, id)).data.get('date', null) is timestamp &&
          getAfter(feedingLogPath(householdId, petId, id)).data.date == at &&
          getAfter(feedingLogPath(householdId, petId, id)).data.get('loggedByUid', null) == uid &&
          getAfter(feedingLogPath(householdId, petId, id)).data.get('loggedByName', null) == name);
    }

    // The state is derived from the surviving logs (src/lib/pets/feed-plan.ts
    // deriveFeedingState): its latest feed and its previous feed are real logs at
    // their own effective times, the previous one is another log and not newer.
    // No snapshot is ever restored, so a corrected or deleted feeding can't come
    // back with an old time.
    function feedingStateHonest(householdId, petId) {
      let after = request.resource.data;
      let prev = after.get('prev', null);
      return feedingStateNames(householdId, petId, after.get('lastLogId', null), after.get('lastFedAt', null),
          after.get('lastFedByUid', null), after.get('lastFedByName', null)) &&
        (prev == null ||
          (prev.get('lastLogId', null) is string &&
            prev.lastLogId != after.get('lastLogId', null) &&
            after.get('lastFedAt', null) is timestamp &&
            prev.get('lastFedAt', null) is timestamp &&
            feedingNow(prev.lastFedAt) <= feedingNow(after.lastFedAt) &&
            feedingStateNames(householdId, petId, prev.lastLogId, prev.lastFedAt,
              prev.get('lastFedByUid', null), prev.get('lastFedByName', null))));
    }

    // The client can't be proven to name the newest log (rules can't query), so
    // the latest feed may only move back in time when the feeding it named is
    // gone after this write (Undo, delete) or its time changed in this write
    // (a correction); otherwise it stays or moves forward (a newer feed, or one
    // that synced from offline). A member can't hide a recent feed this way.
    function feedingLatestMoveAllowed(householdId, petId) {
      let after = request.resource.data;
      let before = resource == null ? null : resource.data;
      return before == null ||
        !(before.get('lastLogId', null) is string) ||
        after.get('lastLogId', null) == before.lastLogId ||
        !existsAfter(feedingLogPath(householdId, petId, before.lastLogId)) ||
        getAfter(feedingLogPath(householdId, petId, before.lastLogId)).data.get('date', null) != before.get('lastFedAt', null) ||
        (after.get('lastFedAt', null) is timestamp && before.get('lastFedAt', null) is timestamp &&
          feedingNow(after.lastFedAt) >= feedingNow(before.lastFedAt));
    }

    function validMedicationLogFields(data, keys) {
      return keys.hasOnly(['date', 'medication', 'dosage', 'notes', 'nextDueDate', 'loggedByUid', 'loggedByName']) &&
        (!('date' in keys) || dateValue(data.date)) &&
        (!('medication' in keys) || boundedString(data.medication, 200)) &&
        (!('dosage' in keys) || boundedString(data.dosage, 200)) &&
        (!('notes' in keys) || optionalString(data.notes, 2000)) &&
        (!('nextDueDate' in keys) || optionalString(data.nextDueDate, 40));
    }

    function validCareLogFields(data, keys) {
      return keys.hasOnly(['date', 'activity', 'notes', 'loggedByUid', 'loggedByName']) &&
        (!('date' in keys) || dateValue(data.date)) &&
        (!('activity' in keys) || boundedString(data.activity, 200)) &&
        (!('notes' in keys) || optionalString(data.notes, 2000));
    }

    // --- Maintenance ------------------------------------------------------

    // A householdId field, when present, names the household in the path.
    function householdIdMatchesPath(householdId) {
      return request.resource.data.get('householdId', householdId) == householdId;
    }

    function validMaintenanceLogFields(data, keys) {
      return keys.hasOnly([
          'householdId', 'targetType', 'assetId', 'vehicleId', 'formerTargetType', 'formerTargetName',
          'title', 'item', 'date', 'type', 'notes', 'cost', 'partsUsed', 'serviceProvider', 'mileage',
          'createdAt', 'updatedAt', 'summary', 'receiptUrl'
        ]) &&
        (!('targetType' in keys) || data.targetType in ['home_asset', 'vehicle', 'general']) &&
        (!('assetId' in keys) || boundedString(data.assetId, 1000)) &&
        (!('vehicleId' in keys) || boundedString(data.vehicleId, 1000)) &&
        (!('formerTargetType' in keys) || data.formerTargetType in ['home_asset', 'vehicle']) &&
        (!('formerTargetName' in keys) || boundedString(data.formerTargetName, 1000)) &&
        (!('title' in keys) || boundedString(data.title, 1000)) &&
        (!('item' in keys) || boundedString(data.item, 1000)) &&
        (!('date' in keys) || boundedString(data.date, 40)) &&
        (!('type' in keys) || data.type in ['repair', 'routine', 'inspection', 'cleaning', 'replacement', 'issue', 'other']) &&
        (!('notes' in keys) || boundedString(data.notes, 20000)) &&
        (!('cost' in keys) || data.cost is number) &&
        (!('partsUsed' in keys) || boundedString(data.partsUsed, 20000)) &&
        (!('serviceProvider' in keys) || boundedString(data.serviceProvider, 1000)) &&
        (!('mileage' in keys) || data.mileage is number) &&
        (!('createdAt' in keys) || boundedString(data.createdAt, 40)) &&
        (!('updatedAt' in keys) || boundedString(data.updatedAt, 40)) &&
        (!('summary' in keys) || boundedString(data.summary, 20000)) &&
        (!('receiptUrl' in keys) || boundedString(data.receiptUrl, 2048));
    }

    function validHomeAssetFields(data, keys) {
      return keys.hasOnly([
          'householdId', 'name', 'category', 'location', 'brand', 'model', 'serialNumber', 'purchaseDate',
          'purchasePrice', 'warrantyExpiration', 'warrantyProvider', 'status', 'notes', 'schedules',
          'createdAt', 'updatedAt'
        ]) &&
        (!('name' in keys) || nonEmptyString(data.name, 1000)) &&
        (!('category' in keys) || boundedString(data.category, 1000)) &&
        (!('location' in keys) || boundedString(data.location, 1000)) &&
        (!('brand' in keys) || boundedString(data.brand, 1000)) &&
        (!('model' in keys) || boundedString(data.model, 1000)) &&
        (!('serialNumber' in keys) || boundedString(data.serialNumber, 1000)) &&
        (!('purchaseDate' in keys) || boundedString(data.purchaseDate, 40)) &&
        (!('purchasePrice' in keys) || data.purchasePrice is number) &&
        (!('warrantyExpiration' in keys) || boundedString(data.warrantyExpiration, 40)) &&
        (!('warrantyProvider' in keys) || boundedString(data.warrantyProvider, 1000)) &&
        (!('status' in keys) || data.status in ['active', 'needs_attention', 'retired']) &&
        (!('notes' in keys) || boundedString(data.notes, 20000)) &&
        (!('schedules' in keys) || boundedList(data.schedules, 100)) &&
        (!('createdAt' in keys) || boundedString(data.createdAt, 40)) &&
        (!('updatedAt' in keys) || boundedString(data.updatedAt, 40));
    }

    function validVehicleFields(data, keys) {
      return keys.hasOnly([
          'householdId', 'nickname', 'year', 'make', 'model', 'trim', 'vin', 'licensePlate', 'currentMileage',
          'purchaseDate', 'purchasePrice', 'insuranceProvider', 'registrationExpiration', 'inspectionExpiration',
          'status', 'notes', 'serviceSchedules', 'createdAt', 'updatedAt'
        ]) &&
        (!('nickname' in keys) || nonEmptyString(data.nickname, 1000)) &&
        (!('year' in keys) || data.year is number) &&
        (!('make' in keys) || boundedString(data.make, 1000)) &&
        (!('model' in keys) || boundedString(data.model, 1000)) &&
        (!('trim' in keys) || boundedString(data.trim, 1000)) &&
        (!('vin' in keys) || boundedString(data.vin, 1000)) &&
        (!('licensePlate' in keys) || boundedString(data.licensePlate, 1000)) &&
        (!('currentMileage' in keys) || data.currentMileage is number) &&
        (!('purchaseDate' in keys) || boundedString(data.purchaseDate, 40)) &&
        (!('purchasePrice' in keys) || data.purchasePrice is number) &&
        (!('insuranceProvider' in keys) || boundedString(data.insuranceProvider, 1000)) &&
        (!('registrationExpiration' in keys) || boundedString(data.registrationExpiration, 40)) &&
        (!('inspectionExpiration' in keys) || boundedString(data.inspectionExpiration, 40)) &&
        (!('status' in keys) || data.status in ['active', 'needs_attention', 'retired', 'sold']) &&
        (!('notes' in keys) || boundedString(data.notes, 20000)) &&
        (!('serviceSchedules' in keys) || boundedList(data.serviceSchedules, 100)) &&
        (!('createdAt' in keys) || boundedString(data.createdAt, 40)) &&
        (!('updatedAt' in keys) || boundedString(data.updatedAt, 40));
    }

    // --- Barcode library --------------------------------------------------

    // A product photo is a download URL of this household's barcode-library
    // folder in this project's Storage (or the Storage emulator for demo-
    // projects), or an Open Food Facts image. Empty means "no photo".
    function validBarcodeImageUrl(householdId, url) {
      let folder = '/o/households%2F' + householdId + '%2Fbarcode-library%2F[^/?#]+([?].*)?$';
      return url == '' ||
        url.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/homehub-j91jb[.](appspot[.]com|firebasestorage[.]app)' + folder) ||
        url.matches('^http://(127[.]0[.]0[.]1|localhost):9199/v0/b/demo-[a-z0-9-]+[.]appspot[.]com' + folder) ||
        url.matches('^https://(images|static)[.]openfoodfacts[.](org|net)/[^?#]*([?].*)?$');
    }

    // createdAt and createdByUid (the writer, optional for older clients) are set on
    // create only; an update may neither change nor remove them. An edit keeps the
    // product's createdAt, while an Add written blindly over an existing product
    // carries a new createdAt (or none) and is refused (BL-3).
    function validBarcodeItemFields(householdId, data, keys) {
      return keys.hasOnly(['name', 'imageUrl', 'imagePath', 'createdAt', 'createdByUid']) &&
        (!('name' in keys) || nonEmptyString(data.name, 200)) &&
        (!('imageUrl' in keys) || (boundedString(data.imageUrl, 2048) && validBarcodeImageUrl(householdId, data.imageUrl))) &&
        (!('imagePath' in keys) ||
          (boundedString(data.imagePath, 512) && data.imagePath.matches('^households/' + householdId + '/barcode-library/[^/]+$'))) &&
        (!('createdAt' in keys) || (resource == null && boundedString(data.createdAt, 40))) &&
        (!('createdByUid' in keys) || (resource == null && data.createdByUid == request.auth.uid)) &&
        (resource == null ||
          (data.get('createdAt', null) == resource.data.get('createdAt', null) &&
            data.get('createdByUid', null) == resource.data.get('createdByUid', null)));
    }

    // --- Shopping stores, settings and usuals (stage S5-S8 rules) -----------

    // A store's aisle order. Rules cannot inspect list elements, so the app keeps
    // each aisleOrder entry a category string of at most 100 characters.
    function validShoppingStoreFields(data, keys) {
      return keys.hasOnly(['name', 'aisleOrder', 'createdByUid', 'updatedAt']) &&
        (!('name' in keys) || nonEmptyString(data.name, 120)) &&
        (!('aisleOrder' in keys) || boundedList(data.aisleOrder, 200)) &&
        (!('createdByUid' in keys) || (resource == null && data.createdByUid == request.auth.uid)) &&
        // Every write stamps the server time; the creator is fixed once set.
        data.get('updatedAt', null) == request.time &&
        (resource == null || data.get('createdByUid', null) == resource.data.get('createdByUid', null));
    }

    // afterTrip: the remembered receipt choice (SH-17b), 'putAwayAndClear' or 'done'.
    function validShoppingSettingsFields(data, keys) {
      return keys.hasOnly(['afterTrip', 'defaultGroceryListId', 'updatedAt']) &&
        (!('afterTrip' in keys) || data.afterTrip in ['putAwayAndClear', 'done']) &&
        (!('defaultGroceryListId' in keys) || optionalString(data.defaultGroceryListId, 200)) &&
        data.get('updatedAt', null) == request.time;
    }

    // A usual is written by the server's put-away; a client may only correct its
    // name and category, removes nothing, and a category change records the writer
    // and the server time.
    function validShoppingUsualUpdate(data, keys) {
      return keys.hasOnly(['name', 'category', 'categoryUpdatedAt', 'categoryUpdatedByUid']) &&
        data.diff(resource.data).removedKeys().size() == 0 &&
        (!('name' in keys) || nonEmptyString(data.name, 500)) &&
        (!('category' in keys) || boundedString(data.category, 100)) &&
        (!('categoryUpdatedAt' in keys) || data.categoryUpdatedAt == request.time) &&
        (!('categoryUpdatedByUid' in keys) || data.categoryUpdatedByUid == request.auth.uid) &&
        (!keys.hasAny(['category', 'categoryUpdatedAt', 'categoryUpdatedByUid']) ||
          (data.get('categoryUpdatedAt', null) == request.time &&
            data.get('categoryUpdatedByUid', null) == request.auth.uid));
    }

    // ---------------------------------------------------------------------
    // Households
    // ---------------------------------------------------------------------

    match /households/{householdId} {
      // Approved members (and, during a deletion, members who were approved: see
      // isDeletingMember). A pending person uses `householdName` on their own record.
      allow get: if isApprovedMember(householdId) || isDeletingMember(householdId) ||
        // A tablet reads its household only once no legacy email copy is left on it.
        (deviceActive(householdId) && !resource.data.keys().hasAny(['memberEmails', 'ownerEmail']));
      allow list: if false;
      // Households are created, renamed, re-owned and deleted only by the server
      // (Admin SDK); no one writes memberEmails or ownerEmail any more (release C).
      allow create: if false;
      allow update: if isOwnerOrAdmin(householdId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeZone', 'updatedAt']) &&
        validHouseholdTimeZone();
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isApprovedMember(householdId) || (signedIn() && request.auth.uid == memberUid) ||
          deviceActive(householdId);
        allow list: if isApprovedMember(householdId) || deviceActive(householdId);

        // Membership records are written only by the server (household creation,
        // joining, approval, role and permission changes, removal, leaving, transfer).
        allow create, update, delete: if false;

        // The member's contact document (`contact`: their email), written only by
        // the server. Readable by the person and by holders of household.manageMembers
        // who also hold household.view.
        match /private/{docId} {
          allow get: if docId == 'contact' &&
            ((signedIn() && request.auth.uid == memberUid) ||
              hasHouseholdManagerPermission(householdId, 'household.manageMembers'));
          allow list, write: if false;
        }
      }

      // Registered tablets: owners and admins read and list them (the Devices tab); a
      // tablet reads its own record in every status (to observe removal). Written
      // only by the server. ops, pinSessions and pinGuards fall to the catch-all deny.
      match /devices/{deviceId} {
        allow get: if isOwnerOrAdmin(householdId) ||
          (isDevice(householdId) && deviceId == request.auth.token.hh_device);
        allow list: if isOwnerOrAdmin(householdId);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        // Only documents addressed to the reader ([uid]) or to everyone (['*']).
        // A list query must carry where('audience', 'array-contains-any', [uid, '*'])
        // (or array-contains of either value); one without it is refused.
        // A tablet reads household-wide notices of the sections it shows, through
        // where('audience', 'array-contains', '*') and where('category', '==', c).
        allow get, list: if (hasHouseholdPermission(householdId, 'notifications.view') &&
          resource.data.audience.hasAny([request.auth.uid, '*'])) ||
          deviceNotificationReadable(householdId);
        allow create: if validNewNotification(householdId);
        allow update: if notificationAddressedToCaller() && (
          (hasHouseholdPermission(householdId, 'notifications.dismiss') && updatesOnlyOwnNotificationState()) ||
          (hasHouseholdPermission(householdId, 'maintenance.edit') && resolvesMaintenanceNotification()));
        allow delete: if false;
      }

      match /maintenance-attachments/{attachmentId} {
        allow read: if hasHouseholdPermission(householdId, 'maintenance.view') || sectionEnabled(householdId, 'maintenance');
        allow create: if hasHouseholdPermission(householdId, 'maintenance.edit') && validNewMaintenanceAttachment(householdId);
        allow update: if false;
        allow delete: if hasHouseholdPermission(householdId, 'maintenance.delete');
      }

      match /auditLogs/{auditId} {
        // Written only by the server, next to the change it records. Read by holders
        // of household.manageMembers who also hold household.view (the Activity tab).
        allow read: if hasHouseholdManagerPermission(householdId, 'household.manageMembers');
        allow write: if false;
      }

      match /chores/{choreId} {
        allow read: if hasHouseholdPermission(householdId, 'chores.view') || sectionEnabled(householdId, 'chores');
        allow create: if hasHouseholdPermission(householdId, 'chores.create') &&
          choreCreatedWithServerCompletion() &&
          request.resource.data.keys().hasAll(['task']) &&
          validChoreFields(request.resource.data, writtenKeys()) &&
          choreServerFieldsAbsent() &&
          choreCreateAssignmentAllowed(householdId);
        allow update: if choreCompletionStampValid() &&
          validChoreFields(request.resource.data, writtenKeys()) &&
          choreServerFieldsUnchanged() &&
          choreDeviceAttributionKept() &&
          choreClientCompletionUnattributed() &&
          (
            // A reopen by a chores.complete holder may also remove the device attribution of
            // the completion it clears (choreDeviceAttributionKept allows removal only then).
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCompleted', 'completedAt', 'completedSubTasks', 'completedAtServer', 'deviceAttribution']) &&
              hasHouseholdPermission(householdId, 'chores.complete')) ||
            hasHouseholdPermission(householdId, 'chores.edit')
          ) &&
          choreReassignmentAllowed(householdId);
        allow delete: if hasHouseholdPermission(householdId, 'chores.delete');
      }

      // Points and streaks are derived from completion times, so every completion is
      // stamped by the server: a chore that becomes completed must carry
      // completedAtServer == request.time (no stamp, or a client-chosen one, is
      // denied), and a completed chore keeps its stamp. Chores completed before the
      // stamp existed keep working: they are already completed, and stats fall back
      // to completedAt for them.
      function choreCompletionStampValid() {
        return request.resource.data.get('isCompleted', false) != true ||
          (resource.data.get('isCompleted', false) == true &&
            request.resource.data.get('completedAtServer', null) == resource.data.get('completedAtServer', null)) ||
          (resource.data.get('isCompleted', false) != true &&
            request.resource.data.get('completedAtServer', null) == request.time);
      }

      function choreCreatedWithServerCompletion() {
        return request.resource.data.get('isCompleted', false) != true ||
          request.resource.data.get('completedAtServer', null) == request.time;
      }

      // Household chore display preferences (leaderboard on/off). Owners and
      // admins change them; everyone who sees chores reads them.
      match /chore-settings/{settingId} {
        allow read: if hasHouseholdPermission(householdId, 'chores.view') || sectionEnabled(householdId, 'chores');
        allow create, update: if settingId == 'preferences' &&
          isOwnerOrAdmin(householdId) &&
          request.resource.data.keys().hasOnly(['leaderboardEnabled', 'updatedAt']) &&
          request.resource.data.leaderboardEnabled is bool &&
          request.resource.data.get('updatedAt', '') is string;
        allow delete: if false;
      }

      match /chore-templates/{templateId} {
        allow read: if hasHouseholdPermission(householdId, 'chores.view') || sectionEnabled(householdId, 'chores');
        allow create: if hasHouseholdPermission(householdId, 'chores.create') &&
          request.resource.data.keys().hasAll(['task']) &&
          validChoreTemplateFields(request.resource.data, writtenKeys()) &&
          templateAssignmentAllowed(householdId);
        allow update: if hasHouseholdPermission(householdId, 'chores.edit') &&
          validChoreTemplateFields(request.resource.data, writtenKeys()) &&
          templateAssignmentAllowed(householdId);
        allow delete: if hasHouseholdPermission(householdId, 'chores.delete');
      }

      match /rooms/{roomId} {
        allow read: if hasHouseholdPermission(householdId, 'chores.view') || sectionEnabled(householdId, 'chores');
        allow create, update: if hasHouseholdPermission(householdId, 'chores.edit');
        allow delete: if hasHouseholdPermission(householdId, 'chores.delete');
      }

      // Yearly chore totals (stats/chores-{year}), written only by server upkeep when
      // it removes old completed chores. Read-only for members who can view chores.
      match /stats/{statId} {
        allow read: if hasHouseholdPermission(householdId, 'chores.view') || sectionEnabled(householdId, 'chores');
        allow write: if false;
      }

      match /shopping-lists/{listId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          request.resource.data.keys().hasAll(['name']) &&
          validShoppingListFields(request.resource.data, writtenKeys());
        allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          validShoppingListFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');

        // Items and categories are written only while their list exists (SH-9b): a
        // list deleted elsewhere (deleteShoppingList removes it and everything under
        // it) takes no more ticks, adds or category edits, and orphans left by older
        // clients cannot be revived. Deletes stay allowed, for cleanup.
        match /items/{itemId} {
          allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
          allow create: if hasHouseholdPermission(householdId, 'shopping.edit') &&
            shoppingListExists(householdId, listId) &&
            request.resource.data.keys().hasAll(['name']) &&
            validShoppingItemFields(request.resource.data, writtenKeys()) &&
            validShoppingItemStamps(request.resource.data, writtenKeys()) &&
            shoppingAdderOnCreate(householdId);
          allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
            shoppingListExists(householdId, listId) &&
            validShoppingItemFields(request.resource.data, writtenKeys()) &&
            validShoppingItemStamps(request.resource.data, writtenKeys()) &&
            shoppingAdderUnchanged();
          allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');
        }

        match /config/{configId} {
          allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
          allow create, update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
            shoppingListExists(householdId, listId) &&
            validShoppingConfig(request.resource.data, writtenKeys());
          allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');
        }
      }

      match /pantry-inventory/{itemId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          request.resource.data.keys().hasAll(['name']) &&
          validPantryFields(request.resource.data, writtenKeys());
        allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          pantryAdderUnchanged() &&
          pantryUpdateAttributed() &&
          validPantryFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');
      }

      match /barcode-library/{barcodeId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          barcodeId.size() <= 128 &&
          validBarcodeItemFields(householdId, request.resource.data, writtenKeys());
        allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          validBarcodeItemFields(householdId, request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');
      }

      // Stores and their aisle order (per-store category order, SH-34).
      match /stores/{storeId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          storeId.size() <= 200 &&
          request.resource.data.keys().hasAll(['name', 'createdByUid', 'updatedAt']) &&
          validShoppingStoreFields(request.resource.data, writtenKeys());
        allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          validShoppingStoreFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'shopping.delete');
      }

      // Household shopping preferences: one document, `preferences`.
      match /shopping-settings/{settingId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create, update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          settingId == 'preferences' &&
          validShoppingSettingsFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'shopping.delete') &&
          settingId == 'preferences';
      }

      // Trip history: written only by the server's put-away and its Undo (Admin SDK).
      match /trips/{tripId} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow write: if false;
      }

      // Usuals (one per item nameKey): created, counted and deleted only by the
      // server; clients may correct the name and category.
      match /shopping-usuals/{nameKey} {
        allow read: if hasHouseholdPermission(householdId, 'shopping.view') || sectionEnabled(householdId, 'shopping');
        allow create, delete: if false;
        allow update: if hasHouseholdPermission(householdId, 'shopping.edit') &&
          validShoppingUsualUpdate(request.resource.data, writtenKeys());
      }

      match /pets/{petId} {
        allow read: if hasHouseholdPermission(householdId, 'pets.view') || sectionEnabled(householdId, 'pets');
        // Meal plans are validated (P2); other pet fields are as in 2.1.
        allow create: if hasHouseholdPermission(householdId, 'pets.editProfiles') && petMealPlanCreate();
        allow update: if hasHouseholdPermission(householdId, 'pets.editProfiles') && petMealPlanUpdate();
        allow delete: if hasHouseholdPermission(householdId, 'pets.editProfiles');

        // Stage R2 (docs/modules/pets/README.md): creates are the feed operation's
        // shapes only (feedingCreateR2); the only update is a time correction.
        match /feeding-logs/{logId} {
          allow read: if hasHouseholdPermission(householdId, 'pets.view') || sectionEnabled(householdId, 'pets');
          allow create: if hasHouseholdPermission(householdId, 'pets.addLogs') &&
            validFeedingLogFields(request.resource.data, createdKeys()) && petLoggerOnCreate() &&
            feedingLoggedAtOnCreate() && feedingCreateR2(householdId, petId, logId);
          allow update: if (hasHouseholdPermission(householdId, 'pets.addLogs') || hasHouseholdPermission(householdId, 'pets.deleteLogs')) &&
            validFeedingLogFields(request.resource.data, updatedKeys()) && petLoggerUnchanged() &&
            feedingLoggedAtUnchanged() && feedingCorrected(householdId) && deviceAttributionKept();
          allow delete: if hasHouseholdPermission(householdId, 'pets.deleteLogs') ||
            feedingAuthorWithinUndoWindow(householdId);
        }

        // The feeding state: a cache of the surviving logs by effective time
        // (latest, previous, today's count), written with every online feed,
        // Undo, delete and time correction; see feedingStateHonest.
        match /feeding-state/{stateId} {
          allow read: if hasHouseholdPermission(householdId, 'pets.view') || sectionEnabled(householdId, 'pets');
          allow create: if stateId == 'current' &&
            (hasHouseholdPermission(householdId, 'pets.addLogs') || hasHouseholdPermission(householdId, 'pets.deleteLogs')) &&
            validFeedingState(request.resource.data) &&
            feedingStateHonest(householdId, petId);
          allow update: if stateId == 'current' &&
            (hasHouseholdPermission(householdId, 'pets.addLogs') || hasHouseholdPermission(householdId, 'pets.deleteLogs')) &&
            validFeedingState(request.resource.data) &&
            feedingStateHonest(householdId, petId) &&
            feedingLatestMoveAllowed(householdId, petId);
          allow delete: if false;
        }

        match /medication-logs/{logId} {
          allow read: if hasHouseholdPermission(householdId, 'pets.view') || sectionEnabled(householdId, 'pets');
          allow create: if hasHouseholdPermission(householdId, 'pets.addLogs') &&
            validMedicationLogFields(request.resource.data, writtenKeys()) && petLoggerOnCreate();
          allow update: if hasHouseholdPermission(householdId, 'pets.addLogs') &&
            validMedicationLogFields(request.resource.data, writtenKeys()) && petLoggerUnchanged() &&
            deviceAttributionKept();
          allow delete: if hasHouseholdPermission(householdId, 'pets.deleteLogs');
        }

        match /care-logs/{logId} {
          allow read: if hasHouseholdPermission(householdId, 'pets.view') || sectionEnabled(householdId, 'pets');
          allow create: if hasHouseholdPermission(householdId, 'pets.addLogs') &&
            validCareLogFields(request.resource.data, writtenKeys()) && petLoggerOnCreate();
          allow update: if hasHouseholdPermission(householdId, 'pets.addLogs') &&
            validCareLogFields(request.resource.data, writtenKeys()) && petLoggerUnchanged() &&
            deviceAttributionKept();
          allow delete: if hasHouseholdPermission(householdId, 'pets.deleteLogs');
        }
      }

      match /home-assets/{assetId} {
        allow read: if hasHouseholdPermission(householdId, 'maintenance.view') || sectionEnabled(householdId, 'maintenance');
        allow create, update: if hasHouseholdPermission(householdId, 'maintenance.edit') &&
          householdIdMatchesPath(householdId) &&
          validHomeAssetFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'maintenance.delete');
      }

      match /vehicles/{vehicleId} {
        allow read: if hasHouseholdPermission(householdId, 'maintenance.view') || sectionEnabled(householdId, 'maintenance');
        allow create, update: if hasHouseholdPermission(householdId, 'maintenance.edit') &&
          householdIdMatchesPath(householdId) &&
          validVehicleFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'maintenance.delete');
      }

      match /maintenance/{logId} {
        allow read: if hasHouseholdPermission(householdId, 'maintenance.view') || sectionEnabled(householdId, 'maintenance');
        allow create: if hasHouseholdPermission(householdId, 'maintenance.createLogs') &&
          householdIdMatchesPath(householdId) &&
          validMaintenanceLogFields(request.resource.data, writtenKeys());
        allow update: if hasHouseholdPermission(householdId, 'maintenance.edit') &&
          householdIdMatchesPath(householdId) &&
          validMaintenanceLogFields(request.resource.data, writtenKeys());
        allow delete: if hasHouseholdPermission(householdId, 'maintenance.delete');
      }

      // Home Assistant credentials hold a long-lived token. No client may read or
      // write them, owners included: the server authorizes the caller and then
      // reads and writes them with the Admin SDK (src/app/automation/actions.ts).
      match /home-automation/{configId} {
        allow read, write: if false;
      }

      match /{unknownPath=**} {
        allow read, write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // AI usage counters: written only by the server (Admin SDK) to enforce the
    // daily AI quota. No client may read or change them.
    // ---------------------------------------------------------------------

    match /aiUsage/{usageId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Invite codes: created, revoked and redeemed only by the server, which checks
    // household.manageInvites, expiry, revocation and use count. Holders of
    // household.manageInvites who also hold household.view read their household's
    // codes (the Invite Codes tab).
    // ---------------------------------------------------------------------

    // Device codes (wall-tablet pairing): created, revoked and redeemed only by the
    // server. Owners and admins (role, not a permission override) of the code's
    // household read them (the Devices tab and the creator's live "Paired" status).
    match /deviceCodes/{code} {
      allow read: if resource.data.householdId is string && isOwnerOrAdmin(resource.data.householdId);
      allow write: if false;
    }

    match /inviteCodes/{code} {
      allow read: if resource.data.householdId is string &&
        hasHouseholdManagerPermission(resource.data.householdId, 'household.manageInvites');
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // User profiles
    // ---------------------------------------------------------------------

    match /users/{userEmail} {
      allow get: if canReadProfile(userEmail);
      allow list: if false;
      allow create: if isProfileOwner(userEmail) &&
        request.resource.data.email == userEmail &&
        request.resource.data.get('householdId', null) == null &&
        request.resource.data.role in ['member', 'user'] &&
        !request.resource.data.keys().hasAny(['birthday', 'gender', 'fcmTokens']) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update: if updatesOwnProfileOnly(userEmail) ||
        clearsOwnMembershipCache(userEmail);
      allow delete: if isProfileOwner(userEmail);

      // Owner-only data housemates must never see. Only the push-token document
      // exists; Cloud Functions read it with the Admin SDK to send pushes.
      match /private/{docId} {
        allow read, delete: if isProfileOwner(userEmail) && docId == 'push';
        allow create: if isProfileOwner(userEmail) && docId == 'push' &&
          validPushTokenDoc(request.resource.data, null);
        allow update: if isProfileOwner(userEmail) && docId == 'push' &&
          validPushTokenDoc(request.resource.data, resource.data);
      }

      // Legacy per-user inbox: readable and dismissible by its owner only.
      // New notifications are household-scoped.
      match /notifications/{notificationId} {
        allow read, update, delete: if isProfileOwner(userEmail);
        allow create: if false;
      }
    }
  }
}
