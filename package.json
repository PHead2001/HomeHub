{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-module-docs.mjs",
    "test:ai": "node --import tsx --experimental-test-isolation=none --test tests/ai/deterministic-flows.test.ts",
    "test:rules": "node scripts/e2e/run-rules.mjs",
    "test:ai:openai:live": "tsx scripts/ai/openai-live-smoke.ts",
    "test:e2e:seed": "node scripts/e2e/seed.mjs",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts tests/e2e/verification-findings.spec.ts tests/e2e/temporary-chores-maintenance-ui.spec.ts tests/e2e/ai-openai.spec.ts tests/e2e/ai-hardening.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:e2e:all": "node scripts/e2e/run-suite.mjs",
    "test:e2e:local": "node scripts/e2e/run-local.mjs",
    "test:e2e:ci": "node scripts/e2e/run-local.mjs --smoke-only",
    "test:e2e:feature:local": "node scripts/e2e/run-local.mjs --feature-only",
    "test:e2e:ai:local": "node scripts/e2e/run-local.mjs --ai-only",
    "test:visual:update:local": "node scripts/e2e/run-local.mjs --visual-update"
  },
