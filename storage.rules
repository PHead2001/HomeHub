rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function memberPath(householdId) {
      return /databases/(default)/documents/households/$(householdId)/members/$(request.auth.uid);
    }

    // Mirrors firestore.rules: households/{id}/members/{uid} is the only authority.
    function roleHasPermission(role, permission) {
      return role == 'owner' ||
        (role == 'admin' && !(permission in ['household.delete', 'household.transferOwnership'])) ||
        (role == 'member' && permission in [
          'household.view',
          'chores.view', 'chores.complete', 'chores.create', 'chores.edit', 'chores.assign',
          'shopping.view', 'shopping.edit',
          'pets.view', 'pets.addLogs',
          'maintenance.view', 'maintenance.createLogs', 'maintenance.edit',
          'automation.view',
          'notifications.view', 'notifications.dismiss'
        ]) ||
        (role == 'child' && permission in [
          'household.view', 'chores.view', 'chores.complete', 'pets.view', 'pets.addLogs',
          'notifications.view', 'notifications.dismiss'
        ]) ||
        (role == 'guest' && permission in [
          'household.view', 'chores.view', 'shopping.view', 'pets.view',
          'maintenance.view', 'notifications.view'
        ]);
    }

    function hasPermission(householdId, permission) {
      return signedIn() &&
        firestore.exists(memberPath(householdId)) &&
        memberHasPermission(firestore.get(memberPath(householdId)).data, permission);
    }

    function memberHasPermission(member, permission) {
      let overrides = member.get('permissions', {});
      return member.role in ['owner', 'admin', 'member', 'child', 'guest'] &&
        member.get('status', 'active') == 'active' &&
        (member.role == 'owner' ||
          (permission in overrides
            ? overrides[permission] == true
            : roleHasPermission(member.role, permission)));
    }

    // Device principals: registered wall tablets (docs/modules/devices/README.md).
    // Reads only; no device uploads. Storage rules may read at most two Firestore
    // documents per evaluation, so the device check reads the device record only:
    // `status` is already `removed` from the first step of a household deletion.
    // The household is always the PATH's household, and the token must name it.
    function isDevicePrincipal() {
      return request.auth != null &&
        request.auth.token.get('hh_kind', '') == 'device' &&
        request.auth.token.firebase.get('sign_in_provider', '') == 'custom' &&
        !('email' in request.auth.token) &&
        request.auth.token.get('hh_device', '') is string &&
        request.auth.uid == 'device_' + request.auth.token.get('hh_device', '') &&
        request.auth.token.get('hh_gen', null) is number &&
        request.auth.token.get('hh_household', '') is string;
    }

    function deviceRecordPath(householdId) {
      return /databases/(default)/documents/households/$(householdId)/devices/$(request.auth.token.hh_device);
    }

    function deviceActiveForStorage(householdId) {
      return isDevicePrincipal() &&
        request.auth.token.hh_household == householdId &&
        firestore.get(deviceRecordPath(householdId)).data.get('status', '') == 'active' &&
        firestore.get(deviceRecordPath(householdId)).data.get('generation', null) == request.auth.token.hh_gen;
    }

    function deviceSectionForStorage(householdId, section) {
      return deviceActiveForStorage(householdId) &&
        firestore.get(deviceRecordPath(householdId)).data.get('sections', {}).get(section, false) == true;
    }

    function isImage(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif|heic|heif|avif)');
    }

    function validMaintenanceFile() {
      return request.resource != null &&
        request.resource.size <= 15 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp|gif|heic|heif|avif)|application/pdf|text/plain|application/msword|application/vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet)');
    }

    match /households/{householdId}/maintenance/{targetType}/{targetId}/{fileName} {
      allow read: if hasPermission(householdId, 'maintenance.view') || deviceSectionForStorage(householdId, 'maintenance');
      allow create: if hasPermission(householdId, 'maintenance.edit') &&
        targetType in ['home_asset', 'vehicle', 'maintenance_log'] &&
        validMaintenanceFile();
      allow update: if false;
      allow delete: if hasPermission(householdId, 'maintenance.delete');
    }

    match /households/{householdId}/barcode-library/{allPaths=**} {
      allow read: if hasPermission(householdId, 'shopping.view') || deviceSectionForStorage(householdId, 'shopping');
      allow create, update: if hasPermission(householdId, 'shopping.edit') && isImage(5 * 1024 * 1024);
      allow delete: if hasPermission(householdId, 'shopping.delete');
    }

    match /households/{householdId}/pets/{allPaths=**} {
      allow read: if hasPermission(householdId, 'pets.view') || deviceSectionForStorage(householdId, 'pets');
      allow create, update: if hasPermission(householdId, 'pets.editProfiles') && isImage(10 * 1024 * 1024);
      allow delete: if hasPermission(householdId, 'pets.editProfiles');
    }

    // Profile photos. Uploads go to the account-ID folder (`users/{uid}/avatars/...`).
    // Older photos under the email (`users/{email}/avatars/...`) stay readable until
    // they are deleted, and their owner may delete them, but nothing new is written
    // there. Google sign-in uids never contain '@' and an email always does, so the
    // keys cannot collide.
    function ownsAvatarFolder(owner) {
      return signedIn() && (request.auth.uid == owner || request.auth.token.email == owner);
    }

    // A tablet reads profile photos for its "Who's here?" row: account-ID folders only,
    // never an email-named folder (the folder name is an email).
    match /users/{owner}/avatars/{allPaths=**} {
      allow read: if signedIn() ||
        (isDevicePrincipal() && deviceActiveForStorage(request.auth.token.hh_household) && !owner.matches('.*@.*'));
      allow create, update: if signedIn() && request.auth.uid == owner && isImage(5 * 1024 * 1024);
      allow delete: if ownsAvatarFolder(owner);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
